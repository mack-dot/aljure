{:applicability-source "(fn [input] (let [c (:context input) head (subs c 0 (min (count c) 2000))] (boolean (and (clojure.string/includes? head \"6 categories\") (every? (fn [l] (clojure.string/includes? head (str \"'\" l \"'\"))) [\"abbreviation\" \"description and abstract concept\" \"entity\" \"human being\" \"location\" \"numeric value\"])))))", :arm "E", :decision :proposed, :description "A1c arm 08 trec_coarse question rules (Opus): abbreviation, numeric value, human being, location or description; nil when no rule matches. Entity is never decided.", :function-source "(fn [text] (let [lab (fn [t] (let [s (clojure.string/lower-case t)] (cond (re-find (re-pattern \"stand for|abbreviat|acronym|what does .* mean\\\\b.*initial\") s) :abb (re-find (re-pattern \"^how (many|much|long|old|far|tall|high|fast|big|large|hot|cold|deep|wide|heavy)|^what year|^when |^what (is|was) the (population|height|length|average|number|cost|price|speed|temperature|distance|area|weight|age)|what percent|how often|^what date|^in what year|^in which year|telephone number|zip code|phone number\") s) :num (re-find (re-pattern \"^who |^whom |^whose |what (actor|president|author|man|woman|person|king|queen|singer|composer)|^which (president|author|actor|man|person)|famous person|name of the (man|woman|person|actor|author|president)\") s) :hum (re-find (re-pattern \"^where |^what (country|city|state|continent|ocean|river|island)|^which (country|city|state|river)|^in what (country|city|state)|capital of|located\") s) :loc (re-find (re-pattern \"^why |^how (do|does|did|can|is|to)|^what (is|are|was|were) (a|an|the)? ?\\\\w+ ?\\\\??$|^what is (a|an) |meaning of|^what does .* mean|difference|definition|^what causes|^what is the (purpose|origin)\") s) :desc :else :ent)))] (get {:abb \"abbreviation\", :num \"numeric value\", :hum \"human being\", :loc \"location\", :desc \"description and abstract concept\"} (lab text))))", :library-sha256 "5911cb470368ae4afe92c6a30f00a5b62d396f948774aac6a384a27b2415e6b4", :name "a1c-trec-rules", :question nil, :schema :aljure-proposal-v1, :seed {:adapter "keyword-label-map-v1: the recorded lab form verbatim as a local fn; :abb :num :hum :loc :desc map to the label names; its :ent default maps to nil (undecided), as Step 0 counted it", :applicability-author "developer", :applicability-provenance :human-edit, :function-provenance :controller-generated, :source-author "model (A1c, Opus)", :source-form-sha256 "5750ca75b5cb7d221d685d40a78b3968404bee27f7412e355d282f49ffdcadac", :source-run "/Users/mackianni/aljure-sonnet-pair-v7/repl-lab/var/benchmarks/sci-ablation-speed-64k/08-aljure", :source-sha256 "a47302f36b044196f9c0379f214257f840ca2edd30464d136497e2137b98ebf0", :source-step 5}}
